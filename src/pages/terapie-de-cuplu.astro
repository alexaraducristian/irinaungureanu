---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import ServiceIntro from '../components/ServiceIntro.astro';
import Faq from '../components/Faq.astro';
import CtaBanner from '../components/CtaBanner.astro';

const candPotrivita = [
  'când simțiți distanță emoțională sau lipsă de conectare',
  'când vă confruntați cu tensiuni repetate, neînțelegeri sau infidelitate',
  'când simțiți că nu vă mai auziți cu adevărat',
  'când unul dintre parteneri se simte singur în relație',
  'când doriți să reconstruiți apropierea și încrederea',
];

const intrebariEsentiale = [
  'Pot conta pe tine?',
  'Mă vezi și mă accepți așa cum sunt?',
  'Ești acolo când am nevoie?',
];

const faq = [
  {
    q: 'Când este momentul potrivit să apelăm la terapie de cuplu?',
    a: 'Când simțiți că discuțiile se transformă frecvent în conflicte, vă îndepărtați emoțional sau repetați aceleași tensiuni fără să rezolvați nimic. Cu cât interveniți mai devreme, cu atât aveți mai multe șanse să reconstruim relația împreună.',
  },
  {
    q: 'Trebuie să venim amândoi?',
    a: 'Ideal este să participați împreună. Totuși, dacă unul dintre parteneri ezită, putem începe cu o ședință individuală.',
  },
  {
    q: 'Vom discuta despre trecut?',
    a: 'Da, dar doar în măsura în care trecutul influențează prezentul vostru de cuplu. Scopul nu este să rămânem în trecut, ci să înțelegem ce se întâmplă acum, între voi, și cum puteți merge mai departe împreună.',
  },
  {
    q: 'Ne vei spune cine greșește?',
    a: 'Nu. Nu e vorba de vină. Vom înțelege împreună ce nevoi și emoții se ascund în spatele conflictelor și cum puteți comunica și relaționa într-un mod mai sigur și mai conectat.',
  },
  {
    q: 'Cât timp trebuie să facem terapie?',
    a: 'Durata procesului variază. Unii parteneri observă schimbări în câteva luni, alții aleg să continue pe termen mai lung, pentru a consolida relația. Decidem împreună ritmul potrivit pentru voi.',
  },
];
---

<Layout
  title="Terapie de cuplu Iași — psihoterapie relațională la cabinet și online"
  rawTitle={true}
  description="Terapie de cuplu în Iași și online pentru reconectare emoțională: comunicare, conflicte, infidelitate, distanțare. Abordare bazată pe atașament. Ședință 80 min · 300 lei."
  keywords={[
    'terapie de cuplu Iași',
    'psihoterapie de cuplu Iași',
    'consiliere de cuplu Iași',
    'terapeut cuplu Iași',
    'terapie de cuplu online',
    'psihoterapeut Iași',
  ]}
>
  <PageHero
    eyebrow="Terapie de cuplu · Iași & online"
    title="Un spațiu sigur pentru relații autentice"
    subtitle="Relațiile apropiate ne aduc cele mai profunde bucurii — și uneori ne provoacă cele mai adânci răni. Terapia de cuplu este un proces de reconectare emoțională."
  />

  <section class="px-4 md:px-6 py-16">
    <div class="max-w-3xl mx-auto reveal">
      <p class="text-lg text-ink-700 leading-relaxed mb-6">
        Când comunicarea în cuplu devine dificilă, conflictele se repetă sau
        distanța emoțională crește, e firesc să apară confuzie, durere sau
        nesiguranță. Terapia de cuplu este un spațiu în care puteți învăța din
        nou cum să fiți în siguranță împreună.
      </p>
      <p class="text-ink-500 leading-relaxed">
        Nu este despre „cine are dreptate”, ci despre cum puteți reconstrui
        siguranța emoțională în relația de cuplu.
      </p>
    </div>
  </section>

  <section class="px-4 md:px-6 pb-8">
    <div class="max-w-3xl mx-auto bg-clay-50 border border-clay-100 rounded-3xl p-8 md:p-10 reveal">
      <h2 class="font-serif text-2xl text-sage-800 mb-5">Întrebări esențiale în cuplu</h2>
      <div class="space-y-3">
        {
          intrebariEsentiale.map((q) => (
            <p class="font-serif text-xl text-sage-700 italic">„{q}”</p>
          ))
        }
      </div>
      <p class="mt-6 text-ink-500 leading-relaxed">
        Aceste întrebări simple se află adesea în spatele certurilor și
        tăcerilor dureroase. În ședințe, le aducem la suprafață și le transformăm
        într-un dialog autentic și vindecător.
      </p>
    </div>
  </section>

  <section class="px-4 md:px-6 py-8">
    <div class="max-w-3xl mx-auto">
      <ServiceIntro heading="Când este potrivită terapia de cuplu" items={candPotrivita} variant="sage" />
    </div>
  </section>

  <section class="px-4 md:px-6 py-8">
    <div class="max-w-3xl mx-auto reveal">
      <div class="bg-sage-600 text-sand-50 rounded-3xl p-8 text-center">
        <p class="text-sm uppercase tracking-[0.18em] text-sage-200 mb-2">
          Cum decurge procesul
        </p>
        <p class="font-serif text-2xl md:text-3xl">80 de minute · 300 lei</p>
        <p class="mt-3 text-sage-100">
          În cabinetul din Iași sau online, în funcție de ceea ce vi se
          potrivește mai bine.
        </p>
      </div>
      <p class="mt-8 text-ink-500 leading-relaxed">
        Lucrez dintr-o perspectivă relațională și bazată pe atașament — o
        abordare validată științific, care privește relația ca pe un spațiu
        esențial de conectare, sprijin și apropiere. În terapie, ne concentrăm pe
        refacerea siguranței emoționale, pas cu pas, cu blândețe și claritate.
      </p>
    </div>
  </section>

  <Faq title="Întrebări frecvente despre terapia de cuplu" items={faq} />

  <CtaBanner
    title="Programează o ședință"
    text="Dacă simțiți că e momentul potrivit să lucrați la relația voastră, vă invit să programați o ședință."
  />
</Layout>
