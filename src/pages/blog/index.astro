---
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
import CtaBanner from '../../components/CtaBanner.astro';
import { posts, formatDate } from '../../data/posts';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const sorted = [...posts].sort(
  (a, b) => new Date(b.date).getTime() - new Date(a.date).getTime()
);
---

<Layout
  title="Blog psihoterapie Iași — emoții, relații și vindecare | Corina Ungureanu"
  rawTitle={true}
  description="Articole scrise de un psihoterapeut din Iași despre emoții, relații, atașament, anxietate și compasiune de sine. Resurse care te pot însoți spre echilibru și vindecare emoțională."
  keywords={[
    'blog psihoterapie',
    'articole psihologie',
    'psihoterapeut Iași blog',
    'sănătate emoțională',
    'anxietate',
    'relații de cuplu',
    'compasiune de sine',
  ]}
>
  <PageHero
    eyebrow="Blog & resurse"
    title="Gânduri despre emoții, relații și vindecare"
    subtitle="Articole scrise cu grijă, care îți pot fi de sprijin între ședințe — sau oricând simți nevoia de un cuvânt blând."
  />

  <section class="px-4 md:px-6 py-16">
    <div class="max-w-6xl mx-auto grid sm:grid-cols-2 lg:grid-cols-3 gap-8">
      {
        sorted.map((post) => (
          <a
            href={`${base}/blog/${post.slug}/`}
            class="group bg-sand-50 border border-sand-200 rounded-3xl overflow-hidden hover:shadow-xl hover:shadow-sage-900/5 hover:-translate-y-1 transition-all duration-300 reveal flex flex-col"
          >
            <div class="aspect-[4/3] overflow-hidden">
              <Image
                src={post.cover}
                alt={post.title}
                width={600}
                height={450}
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
              />
            </div>
            <div class="p-6 flex flex-col flex-1">
              <div class="flex items-center gap-2 text-xs text-ink-500 mb-3">
                <span class="bg-sage-100 text-sage-700 px-2.5 py-1 rounded-full font-semibold">
                  {post.category}
                </span>
                <span>{formatDate(post.date)}</span>
              </div>
              <h2 class="font-serif text-xl text-sage-800 leading-snug mb-2 group-hover:text-sage-600 transition-colors">
                {post.title}
              </h2>
              <p class="text-sm text-ink-500 leading-relaxed flex-1">
                {post.excerpt}
              </p>
              <span class="mt-4 text-sage-600 font-semibold text-sm inline-flex items-center gap-1 group-hover:gap-2 transition-all">
                Citește articolul →
              </span>
            </div>
          </a>
        ))
      }
    </div>
  </section>

  <CtaBanner />
</Layout>
