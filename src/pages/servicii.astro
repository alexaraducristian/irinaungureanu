---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import CtaBanner from '../components/CtaBanner.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const servicii = [
  {
    title: 'Terapie individuală',
    text: 'Un spațiu pentru echilibru și vindecare emoțională. Pentru momentele în care emoțiile devin greu de gestionat și ai nevoie de claritate și sprijin.',
    href: `${base}/terapie-individuala/`,
    meta: '50 min · 200 lei · Iași sau online',
    icon: '🌿',
  },
  {
    title: 'Terapie de cuplu',
    text: 'Un proces de reconectare emoțională. Pentru cuplurile care simt distanță, tensiuni repetate sau care vor să reconstruiască siguranța și apropierea.',
    href: `${base}/terapie-de-cuplu/`,
    meta: '80 min · 300 lei · Iași sau online',
    icon: '🤝',
  },
  {
    title: 'Terapie de familie',
    text: 'Sprijin pentru familii care trec prin tensiuni, conflicte între generații sau perioade de schimbare — cu blândețe și fără a căuta vinovați.',
    href: `${base}/terapie-de-familie/`,
    meta: '90 min · Iași sau online',
    icon: '🏡',
  },
  {
    title: 'Terapie online',
    text: 'Același spațiu de încredere și prezență, oriunde te-ai afla. Pentru flexibilitate, continuitate și confortul propriului tău spațiu.',
    href: `${base}/terapie-online/`,
    meta: '50 min · 200 lei · WhatsApp Video',
    icon: '💻',
  },
];
---

<Layout
  title="Servicii psihoterapie Iași — individuală, cuplu, familie, online"
  rawTitle={true}
  description="Servicii de psihoterapie în Iași și online: terapie individuală, de cuplu, de familie și online. Alege forma de sprijin potrivită pentru tine."
  keywords={[
    'servicii psihoterapie Iași',
    'terapie individuală Iași',
    'terapie de cuplu Iași',
    'terapie de familie Iași',
    'terapie online',
    'psiholog Iași',
    'prețuri psihoterapie Iași',
  ]}
>
  <PageHero
    eyebrow="Servicii oferite"
    title="Cum putem lucra împreună"
    subtitle="Fiecare drum este diferit. Alege forma de sprijin care ți se potrivește — sau scrie-mi și o găsim împreună."
  />

  <section class="px-4 md:px-6 py-16">
    <div class="max-w-5xl mx-auto grid sm:grid-cols-2 gap-6">
      {
        servicii.map((s) => (
          <a
            href={s.href}
            class="group bg-sand-50 border border-sand-200 rounded-3xl p-8 hover:shadow-xl hover:shadow-sage-900/5 hover:-translate-y-1 transition-all duration-300 reveal flex flex-col"
          >
            <span class="text-3xl mb-4">{s.icon}</span>
            <h2 class="font-serif text-2xl text-sage-800 mb-2">{s.title}</h2>
            <p class="text-ink-500 leading-relaxed flex-1">{s.text}</p>
            <p class="mt-5 text-xs uppercase tracking-[0.14em] text-sage-600 font-bold">
              {s.meta}
            </p>
            <span class="mt-3 text-sage-600 font-semibold text-sm inline-flex items-center gap-1 group-hover:gap-2 transition-all">
              Află mai mult →
            </span>
          </a>
        ))
      }
    </div>
  </section>

  <CtaBanner />
</Layout>
