---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FloatingContact from '../components/FloatingContact.astro';
import { site, globalKeywords } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  keywords?: string[];
  noindex?: boolean;
  /** Dacă titlul este deja complet, nu mai adăuga sufixul de brand. */
  rawTitle?: boolean;
}

const {
  title = 'Psihoterapeut Iași — Corina Ungureanu | Terapie individuală, de cuplu și online',
  description = 'Psihoterapeut în Iași și online. Corina Ungureanu oferă terapie individuală, de cuplu și de familie — un cabinet de psihoterapie cald, sigur și fără judecată. Programează o ședință.',
  image,
  keywords = [],
  noindex = false,
  rawTitle = false,
} = Astro.props;

// Titlu: dacă pagina nu dă un titlu "raw", adăugăm sufix cu brand + locație.
const fullTitle = rawTitle
  ? title
  : title.includes('Iași') || title.includes('Corina Ungureanu')
    ? title
    : `${title} | Psihoterapeut Iași — Corina Ungureanu`;

// Keywords: unim cele globale cu cele specifice paginii, eliminând duplicatele.
const allKeywords = [...new Set([...keywords, ...globalKeywords])].join(', ');

const canonicalPath = Astro.url.pathname.endsWith('/')
  ? Astro.url.pathname
  : Astro.url.pathname + '/';
const canonicalURL = new URL(canonicalPath, Astro.site);
const base = import.meta.env.BASE_URL; // ex: /irinaungureanu/
const ogImage = image || new URL(`${base}og-default.svg`, Astro.site).href;
---

<!doctype html>
<html lang="ro">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="keywords" content={allKeywords} />
    <meta name="author" content="Corina Ungureanu" />
    <meta
      name="robots"
      content={noindex
        ? 'noindex, follow'
        : 'index, follow, max-image-preview:large, max-snippet:-1'}
    />
    <meta name="language" content="Romanian" />

    <!-- SEO local Iași -->
    <meta name="geo.region" content="RO-IS" />
    <meta name="geo.placename" content="Iași" />
    <meta name="geo.position" content={`${site.geo.lat};${site.geo.lng}`} />
    <meta name="ICBM" content={`${site.geo.lat}, ${site.geo.lng}`} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL.href} />
    <meta property="og:site_name" content="Corina Ungureanu — Psihoterapeut Iași" />
    <meta property="og:locale" content="ro_RO" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Corina Ungureanu — psihoterapeut în Iași și online" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="canonical" href={canonicalURL.href} />

    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <meta name="generator" content={Astro.generator} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400&family=Nunito+Sans:wght@300;400;600;700&display=swap"
      rel="stylesheet"
    />

    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': ['MedicalBusiness', 'Psychologist'],
        '@id': new URL(base, Astro.site).href + '#business',
        name: 'Corina Ungureanu — Psihoterapeut Iași',
        alternateName: 'Cabinet psihoterapie Corina Ungureanu',
        description,
        url: new URL(base, Astro.site).href,
        image: ogImage,
        telephone: site.phone,
        email: site.email,
        priceRange: site.priceRange,
        currenciesAccepted: 'RON',
        address: {
          '@type': 'PostalAddress',
          addressLocality: site.city,
          addressRegion: site.region,
          addressCountry: site.country,
        },
        geo: {
          '@type': 'GeoCoordinates',
          latitude: site.geo.lat,
          longitude: site.geo.lng,
        },
        areaServed: [
          { '@type': 'City', name: 'Iași' },
          { '@type': 'Country', name: 'România' },
          'online',
        ],
        medicalSpecialty: 'Psychiatric',
        knowsAbout: [
          'psihoterapie',
          'terapie individuală',
          'terapie de cuplu',
          'terapie de familie',
          'terapie online',
          'anxietate',
          'depresie',
          'atacuri de panică',
          'teoria atașamentului',
          'traumă',
        ],
        knowsLanguage: ['ro'],
        founder: {
          '@type': 'Person',
          name: 'Corina Ungureanu',
          jobTitle: 'Psihoterapeut',
          memberOf: {
            '@type': 'Organization',
            name: 'Colegiul Psihologilor din România',
          },
        },
        availableService: [
          { '@type': 'MedicalTherapy', name: 'Terapie individuală — Iași & online' },
          { '@type': 'MedicalTherapy', name: 'Terapie de cuplu — Iași & online' },
          { '@type': 'MedicalTherapy', name: 'Terapie de familie — Iași & online' },
          { '@type': 'MedicalTherapy', name: 'Terapie online' },
        ],
        ...(site.social.length ? { sameAs: site.social } : {}),
      })}
    />

    <title>{fullTitle}</title>
  </head>
  <body class="pb-16 md:pb-0">
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:z-[200] focus:bg-sage-600 focus:text-white focus:px-4 focus:py-2 focus:rounded-lg"
      >Salt la conținut</a
    >
    <Header />
    <main id="main-content">
      <slot />
    </main>
    <Footer />
    <FloatingContact />

    <script is:inline>
      // Fade-in la scroll
      const io = new IntersectionObserver(
        (entries) => {
          entries.forEach((e) => {
            if (e.isIntersecting) {
              e.target.classList.add('is-visible');
              io.unobserve(e.target);
            }
          });
        },
        { threshold: 0.12 }
      );
      document.querySelectorAll('.reveal').forEach((el) => io.observe(el));
    </script>
  </body>
</html>
