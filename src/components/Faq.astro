---
interface Props {
  title?: string;
  items: { q: string; a: string }[];
}
const { title = 'Întrebări frecvente', items } = Astro.props;
---

<section class="px-4 md:px-6 py-16">
  <div class="max-w-3xl mx-auto">
    <h2 class="font-serif text-3xl md:text-4xl text-sage-800 text-center mb-10 reveal">
      {title}
    </h2>
    <div class="space-y-3">
      {
        items.map((item) => (
          <details class="group bg-sand-50 border border-sand-200 rounded-2xl reveal">
            <summary class="flex items-center justify-between gap-4 cursor-pointer list-none px-6 py-5 font-semibold text-sage-800">
              <span>{item.q}</span>
              <span class="w-7 h-7 flex-shrink-0 rounded-full bg-sage-100 text-sage-600 flex items-center justify-center transition-transform group-open:rotate-45">
                +
              </span>
            </summary>
            <div class="px-6 pb-5 -mt-1 text-ink-500 leading-relaxed">
              {item.a}
            </div>
          </details>
        ))
      }
    </div>
  </div>
</section>
