---
import { nav, site } from '../data/site';

const { pathname } = Astro.url;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

function isActive(href: string) {
  const a = pathname.replace(/\/$/, '');
  const b = href.replace(/\/$/, '');
  if (b === base || b === '') return a === '' || a === base;
  return a === b;
}

function isParentActive(href: string, children?: { href: string }[]) {
  if (isActive(href)) return true;
  return (children ?? []).some((c) => isActive(c.href));
}
---

<header
  class="bg-sand-50/90 backdrop-blur border-b border-sand-200 sticky top-0 z-50"
>
  <div
    class="max-w-6xl mx-auto px-4 md:px-6 flex items-center justify-between py-4"
  >
    <a href={import.meta.env.BASE_URL} class="flex items-center gap-3 group">
      <span
        class="w-11 h-11 rounded-full bg-sage-600 text-sand-50 flex items-center justify-center font-serif text-xl shadow-sm group-hover:bg-sage-700 transition-colors"
        >CU</span
      >
      <span class="leading-tight">
        <span class="block font-serif text-xl text-sage-800">{site.name}</span>
        <span class="block text-xs uppercase tracking-[0.18em] text-ink-500"
          >{site.role}</span
        >
      </span>
    </a>

    <!-- Hamburger (mobil) -->
    <button
      id="menu-toggle"
      class="md:hidden flex flex-col items-center justify-center w-10 h-10 rounded-lg bg-sage-100 hover:bg-sage-200 transition-colors"
      aria-label="Deschide meniul"
      aria-expanded="false"
    >
      <span class="block w-5 h-0.5 bg-sage-800"></span>
      <span class="block w-5 h-0.5 bg-sage-800 mt-1.5"></span>
      <span class="block w-5 h-0.5 bg-sage-800 mt-1.5"></span>
    </button>

    <!-- Nav desktop -->
    <nav class="hidden md:block">
      <ul class="flex items-center gap-1 lg:gap-2">
        {
          nav.links.map((link) =>
            link.children ? (
              <li class="relative group">
                <a
                  href={link.href}
                  class:list={[
                    'px-3 py-2 rounded-full text-sm font-semibold transition-colors flex items-center gap-1',
                    isParentActive(link.href, link.children)
                      ? 'bg-sage-600 text-sand-50'
                      : 'text-ink-700 hover:bg-sage-100 hover:text-sage-800',
                  ]}
                >
                  {link.text}
                  <svg class="w-3 h-3" viewBox="0 0 12 12" fill="none">
                    <path
                      d="M3 4.5 6 7.5 9 4.5"
                      stroke="currentColor"
                      stroke-width="1.6"
                      stroke-linecap="round"
                    />
                  </svg>
                </a>
                <ul class="absolute left-0 top-full pt-2 w-56 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200">
                  <div class="bg-sand-50 border border-sand-200 rounded-2xl shadow-lg shadow-sage-900/5 p-2">
                    {link.children.map((c) => (
                      <li>
                        <a
                          href={c.href}
                          class:list={[
                            'block px-4 py-2.5 rounded-xl text-sm transition-colors',
                            isActive(c.href)
                              ? 'bg-sage-100 text-sage-800 font-semibold'
                              : 'text-ink-700 hover:bg-sage-50 hover:text-sage-800',
                          ]}
                        >
                          {c.text}
                        </a>
                      </li>
                    ))}
                  </div>
                </ul>
              </li>
            ) : (
              <li>
                <a
                  href={link.href}
                  class:list={[
                    'px-3 py-2 rounded-full text-sm font-semibold transition-colors',
                    isActive(link.href)
                      ? 'bg-sage-600 text-sand-50'
                      : 'text-ink-700 hover:bg-sage-100 hover:text-sage-800',
                  ]}
                >
                  {link.text}
                </a>
              </li>
            )
          )
        }
        <li>
          <a
            href={`${base}/contact/`}
            class="ml-1 inline-flex items-center gap-2 bg-clay-500 hover:bg-clay-600 text-white px-4 py-2 rounded-full text-sm font-bold transition-colors shadow-sm"
          >
            Programează
          </a>
        </li>
      </ul>
    </nav>
  </div>
</header>

<!-- Overlay + drawer mobil -->
<div
  id="mobile-overlay"
  class="fixed inset-0 bg-ink-900/40 z-[60] hidden opacity-0 transition-opacity duration-300 md:hidden"
>
</div>
<nav
  id="mobile-menu"
  class="fixed top-0 right-0 h-full w-80 max-w-[85vw] bg-sand-50 z-[70] shadow-2xl transform translate-x-full transition-transform duration-300 ease-in-out md:hidden overflow-y-auto"
  aria-label="Meniu mobil"
>
  <div class="flex items-center justify-between p-5 border-b border-sand-200">
    <span class="font-serif text-lg text-sage-800">{site.name}</span>
    <button
      id="menu-close"
      class="w-9 h-9 flex items-center justify-center rounded-lg bg-sage-100 hover:bg-sage-200 transition-colors"
      aria-label="Închide meniul"
    >
      <svg class="w-5 h-5 text-sage-800" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18 18 6M6 6l12 12" />
      </svg>
    </button>
  </div>

  <ul class="p-4 space-y-1">
    {
      nav.links.map((link) => (
        <li>
          <a
            href={link.href}
            class:list={[
              'block px-4 py-3 rounded-xl text-base font-semibold transition-colors',
              isParentActive(link.href, (link as any).children)
                ? 'bg-sage-600 text-sand-50'
                : 'text-ink-700 hover:bg-sage-100',
            ]}
          >
            {link.text}
          </a>
          {(link as any).children && (
            <ul class="mt-1 ml-3 space-y-1 border-l-2 border-sand-200 pl-3">
              {(link as any).children.map((c: { text: string; href: string }) => (
                <li>
                  <a
                    href={c.href}
                    class:list={[
                      'block px-3 py-2 rounded-lg text-sm transition-colors',
                      isActive(c.href)
                        ? 'bg-sage-100 text-sage-800 font-semibold'
                        : 'text-ink-500 hover:bg-sage-50 hover:text-sage-800',
                    ]}
                  >
                    {c.text}
                  </a>
                </li>
              ))}
            </ul>
          )}
        </li>
      ))
    }
  </ul>

  <div class="p-4">
    <a
      href={`${base}/contact/`}
      class="block w-full text-center bg-clay-500 text-white px-6 py-3 rounded-xl font-bold hover:bg-clay-600 transition-colors shadow"
    >
      Programează o ședință
    </a>
  </div>
</nav>

<script>
  const toggle = document.getElementById('menu-toggle');
  const close = document.getElementById('menu-close');
  const overlay = document.getElementById('mobile-overlay');
  const menu = document.getElementById('mobile-menu');

  function openMenu() {
    menu?.classList.remove('translate-x-full');
    overlay?.classList.remove('hidden');
    requestAnimationFrame(() => overlay?.classList.remove('opacity-0'));
    toggle?.setAttribute('aria-expanded', 'true');
    document.body.style.overflow = 'hidden';
  }
  function closeMenu() {
    menu?.classList.add('translate-x-full');
    overlay?.classList.add('opacity-0');
    setTimeout(() => overlay?.classList.add('hidden'), 300);
    toggle?.setAttribute('aria-expanded', 'false');
    document.body.style.overflow = '';
  }
  toggle?.addEventListener('click', openMenu);
  close?.addEventListener('click', closeMenu);
  overlay?.addEventListener('click', closeMenu);
</script>
